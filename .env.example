# Configuration REFERENCE for the Document Extraction Engine (Modules A, B and C).
#
# HOW THIS FILE IS USED: it is a template/reference only. The application does NOT read a `.env`
# file or process environment variables: nothing in the code loads them (Settings is a plain
# pydantic model). Each KEY below is the upper-case form of a field on
# doc_extractor.config.Settings; supply values in code:
#
#     from doc_extractor.config import Settings, load_settings
#     settings = Settings(ocr_backend="pdfium", llm_model_name="ollama/qwen2.5:7b-instruct")
#     settings = load_settings({"app_env": "staging", "max_page_count": 50})   # validated copy
#
# then pass it on (ModuleBPipeline(..., settings=settings), doc_extractor.app.configure_settings(...)).
# Copying this file to `.env` has no effect. Copy values into your own deployment's config
# mechanism / secrets manager; never commit secrets.
#
# ONE EXCEPTION: the REST API (doc_extractor.api, optional `api` extra) reads its own deployment
# posture from DOC_API_* process environment variables - see the last block of this file.
#
# NOTE: All configuration values must support private, on-premise / VPC customer deployment.

# Application Environment: development | staging | production
APP_ENV=development
APP_NAME=doc-extraction-engine
SERVICE_NAME=module-a-ingestion
LOG_LEVEL=INFO
DEBUG=false

# Deployment & Network Isolation (ARC-001, SEC-011)
# Fail-closed: Deny outbound external egress
ALLOW_EXTERNAL_EGRESS=false

# Ingestion Constraints & Guardrails (FR-ING-001, FR-ING-002, GR-001)
MAX_FILE_SIZE_BYTES=52428800           # 50 MB default max upload size
MAX_PAGE_COUNT=100                     # Max pages allowed per document
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/tiff
TARGET_RENDER_DPI=200                  # Strict PRD standard: 200 DPI (FR-ING-004, SCH-013)

# Storage & Multi-Tenancy (ARC-003, SEC-005, SEC-006)
STORAGE_BASE_DIR=./data/storage
ENABLE_STORAGE_ENCRYPTION=false        # In production, must be true backed by customer KMS/HSM

# Security & Malware Scanning (FR-ING-003, SEC-009)
MALWARE_SCAN_ENABLED=true
# Development only. Leave unset (or set clamav_socket) outside development: 'mock' is refused in staging and production.
# Production: clamav_socket with MALWARE_CLAMAV_ADDRESS (SEC-009).
MALWARE_SCANNER_TYPE=mock

# Module B OCR backend: mirrors the Settings.ocr_* fields
# Default 'passthrough' = explicit no-OCR mode (needs nothing installed). 'pdfium' reads the native PDF text layer. No automatic fallback.
OCR_BACKEND=passthrough                 # passthrough | pdfium | none (no-parser, fails closed)

# Local LLM Extraction Configuration (Module C / PRD ARC-004, ARC-005)
# Default is the Ollama TEXT model (extracts from Module B markdown). The multimodal Qwen-VL path
# (PRD v1.5: Qwen/Qwen3-VL-4B-Instruct by default) is selected through the extractor / routing table, not this field - see README.
LLM_MODEL_NAME=ollama/qwen2.5:7b-instruct
LLM_API_BASE=http://localhost:11434
LLM_PROVIDER=ollama
LLM_USE_INFERENCE=false                 # Set true to enable local LLM extraction
LLM_ALLOW_FALLBACK=false                # Strict no-fallback policy for extraction
LLM_TIMEOUT_SECONDS=30.0


# ---------------------------------------------------------------------------------------------
# PRD v1.5 runtime settings - NOT fields of Settings: these are real process environment variables
# read by the Qwen runtime and the demo app (set them with `export` / `%env`, not through Settings).
# ---------------------------------------------------------------------------------------------
# DOC_DEFAULT_MODEL=Qwen/Qwen3-VL-4B-Instruct   # Qwen/Qwen3-VL-8B-Instruct on a >= 24 GB GPU
# DOC_MAX_IMAGE_PIXELS=1300000                  # cap on the page image sent to the model (4200000 = full 200 DPI)
# DOC_CLASSIFY_MAX_PIXELS=500000                # size of the image used for classification
# DOC_DEVICE_MAP=single                         # single (GPU 0) | balanced | auto
# DOC_ROUTER_MODEL=                              # a different model just for classification
# DOC_MAX_PAGES=0                               # 0 = read every page
# DOC_PRELOAD=1                                 # load the models at startup
# DOC_ROUTING_TABLE=                             # path to a JSON routing table
# DOC_TRUST_REMOTE_CODE_MODELS=                  # explicit opt-in: comma-separated extra model ids allowed to run repo code

# ---------------------------------------------------------------------------------------------
# REST API (doc_extractor.api) - REAL process environment variables read by create_app().
# Only these names are read; any other DOC_API_* name, an empty value or an invalid value stops
# start-up with a ConfigurationError (a typo can never silently leave the API in development).
# Explicit values passed in code (load_api_settings({...})) win over the environment.
# ---------------------------------------------------------------------------------------------
# DOC_API_ENV=production                 # REQUIRED: development | staging | production. There is NO default:
#                                        # the API refuses to start when it is unset (it never assumes development)
# DOC_API_DEBUG=false                    # refused in production and staging
# DOC_API_DOCS_ENABLED=                  # /docs, /redoc, /openapi.json: default on in development ONLY;
#                                        # staging may set true; refused in production
# DOC_API_CORS_ORIGINS=https://app.example.com,https://admin.example.com   # comma separated; '*' refused in production/staging
# DOC_API_CORS_ALLOW_CREDENTIALS=true
# DOC_API_PREFIX=/api/v1
# DOC_API_ALLOW_CLIENT_REQUEST_ID=true
# DOC_API_LOG_LEVEL=INFO
# DOC_API_STORAGE_BASE_DIR=/var/lib/doc-extractor
# DOC_API_MAX_CONCURRENT_UPLOADS=2       # maximum concurrent upload requests admitted before HTTP 429
# DOC_API_UPLOAD_BODY_IDLE_TIMEOUT_SECONDS=30     # upload body: longest pause without body bytes before HTTP 408 (finite, 0 < x <= 300)
# DOC_API_UPLOAD_BODY_TOTAL_TIMEOUT_SECONDS=300  # upload body: longest total time for the whole body before HTTP 408 (finite, idle <= x <= 3600)
# DOC_API_MAX_CONCURRENT_EXTRACTIONS=2           # extract-sync: executions running at once before HTTP 429 (1..64)
# DOC_API_EXTRACT_SYNC_TIMEOUT_SECONDS=30        # extract-sync deadline in seconds (0 < x <= 30, PRD API-004)
#
# MongoDB persistence (Team Member 3, Phase 2A). Needs the 'mongo' extra: pip install -e ".[mongo]".
# DEVELOPMENT only: leave all of these unset to run without MongoDB (the persistence ports then answer 503 SERVICE_UNAVAILABLE).
# STAGING and PRODUCTION REQUIRE them: the application refuses to start without a valid, reachable MongoDB replica set.
# Set EITHER the connection string OR the file that holds it (a mounted secret: preferred), never both. A database name is
# required with either; there is no default. staging and production require TLS, authentication and a replica set.
# DOC_API_MONGO_URI=mongodb://user:password@mongo-0:27017,mongo-1:27017/?replicaSet=rs0&tls=true   # a SECRET; never commit
# DOC_API_MONGO_URI_FILE=/run/secrets/mongo_uri   # file holding the connection string (read at start-up)
# DOC_API_MONGO_DATABASE=doc_extractor            # required with the connection string
# DOC_API_MONGO_REPLICA_SET=rs0                   # pins the expected replica set name (optional)
# DOC_API_MONGO_SERVER_SELECTION_TIMEOUT_MS=5000  # 100..30000
# DOC_API_MONGO_CONNECT_TIMEOUT_MS=5000           # 100..30000
# DOC_API_MONGO_SOCKET_TIMEOUT_MS=30000           # 1000..120000
# DOC_API_MONGO_MAX_POOL_SIZE=50                  # 1..500
# DOC_API_MONGO_MIN_POOL_SIZE=0                   # 0..500, not above the maximum
# DOC_API_MONGO_ENSURE_INDEXES=true               # create the declared indexes at start-up (idempotent; never drops one)

# --- Durable message broker (Phase 3): RabbitMQ quorum queues are the working baseline, NOT an approved decision. Needs MongoDB (the
# --- lease store keeps job ownership, attempts and fencing tokens there). Unset: no broker, and the queue ports answer 503.
# DOC_API_BROKER_URL=amqps://user:password@rabbit-0:5671/vhost   # a SECRET; staging and production require amqps:// and credentials
# DOC_API_BROKER_URL_FILE=/run/secrets/broker_url  # file holding the URL (read at start-up); not together with DOC_API_BROKER_URL
# DOC_API_BROKER_QUEUE_PREFIX=doc_extractor        # lowercase letters, digits, underscores, hyphens (1..48, starts with a letter)
# DOC_API_BROKER_MAX_IN_FLIGHT=10                  # 1..100 unacknowledged messages per consumer
# DOC_API_BROKER_CONNECT_TIMEOUT_SECONDS=10        # 1..60
# DOC_API_BROKER_PUBLISH_TIMEOUT_SECONDS=10        # 1..60 (publish, get and acknowledge)

# --- S3 Object Storage (Team Member 3, Phase 4A). Needs the 'storage' extra: pip install -e ".[storage]".
# Supports AWS S3, MinIO, Ceph, and customer-controlled S3-compatible private cloud deployments.
# Leave DOC_API_STORAGE_BACKEND unset or 'local' to use tenant-isolated local filesystem storage.
# When DOC_API_STORAGE_BACKEND=s3, DOC_API_S3_BUCKET is required and failures fail closed (no local fallback).
# DOC_API_STORAGE_BACKEND=s3                      # 'local' (default) | 's3'
# DOC_API_S3_BUCKET=my-document-bucket            # REQUIRED when storage_backend is 's3': DNS-compliant 3..63 chars
# DOC_API_S3_ENDPOINT_URL=https://s3.corp:9000    # Optional custom endpoint (MinIO, Ceph). Staging/production requires https://
# DOC_API_S3_REGION=us-east-1                     # AWS or custom S3 region
# DOC_API_S3_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE   # a SECRET; prefer DOC_API_S3_ACCESS_KEY_ID_FILE
# DOC_API_S3_ACCESS_KEY_ID_FILE=/run/secrets/s3_access_key
# DOC_API_S3_SECRET_ACCESS_KEY=wJalrXUtnFEMI...   # a SECRET; prefer DOC_API_S3_SECRET_ACCESS_KEY_FILE
# DOC_API_S3_SECRET_ACCESS_KEY_FILE=/run/secrets/s3_secret_key
# DOC_API_S3_SESSION_TOKEN=                       # optional STS session token
# DOC_API_S3_FORCE_PATH_STYLE=true                # true for MinIO/Ceph, false for AWS S3 (inferred automatically if unset)
# DOC_API_S3_PREFIX=doc-extractor/                # optional key prefix inside the bucket
# DOC_API_S3_CONNECT_TIMEOUT_SECONDS=5.0          # 0.5..60.0
# DOC_API_S3_READ_TIMEOUT_SECONDS=30.0            # 1.0..300.0
# DOC_API_S3_VERIFY_SSL=true                      # must be true outside development
# DOC_API_S3_CA_BUNDLE=/etc/ssl/certs/corp-ca.pem # optional custom CA bundle for enterprise PKI
# DOC_API_S3_SPOOL_DIR=/var/spool/doc-extractor   # local temporary spool directory for descriptor operations
#
# --- S3 Object Storage Envelope Encryption & KMS (Team Member 3, Phase 4B).
# Authenticated AES-256-GCM envelope encryption protecting stored objects with per-object DEKs wrapped under KMS KEKs.
# DOC_API_STORAGE_ENCRYPTION_ENABLED=true          # true | false (default: false)
# DOC_API_KMS_PROVIDER_TYPE=aws_kms                # 'aws_kms' | 'fake' (fake is forbidden outside development)
# DOC_API_KMS_KEK_ID=arn:aws:kms:us-east-1:123456789012:key/... # KMS Key Encryption Key (ARN or alias)
# DOC_API_KMS_KEY_VERSION=v1                       # Active key version tag
# DOC_API_KMS_ENDPOINT_URL=https://kms.corp:8443   # Optional custom KMS endpoint (LocalStack, KMS emulator, HSM proxy)
# DOC_API_SPOOL_IS_PROTECTED=true                  # Required for full SEC-005: indicates local disk spool has volume encryption
#
# --- Independently Signed Audit Checkpoints & External Immutable Storage (Team Member 3, Phase 4C - SEC-008).
# Extends MongoDB audit hash chain with KMS-signed checkpoints stored in S3 Object Lock (WORM).
# DOC_API_AUDIT_CHECKPOINT_ENABLED=true           # true | false (default: false)
# DOC_API_AUDIT_CHECKPOINT_SINK_TYPE=s3           # 'memory' (dev only) | 's3' (Object Lock immutable sink)
# DOC_API_AUDIT_SIGNING_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/... # Asymmetric KMS signing key (RSA-PSS)
# DOC_API_AUDIT_SIGNING_KEY_VERSION=v1            # Active signing key version tag
# DOC_API_AUDIT_OBJECT_LOCK_RETENTION_DAYS=365    # Retention period in days for compliance retention (>= 1)
# DOC_API_AUDIT_OBJECT_LOCK_MODE=COMPLIANCE       # 'COMPLIANCE' (unalterable even by root) | 'GOVERNANCE'
#
# --- Internal Identity, JWT, MFA & Customer OIDC Federation (Team Member 3, Phase 5A - SEC-001, SEC-002, SEC-003).
# RS256 token verification, rotating single-use refresh tokens, TOTP MFA, and customer OIDC SSO.
# DOC_API_JWT_PUBLIC_KEY_PATH=/etc/jwt/public.pem  # RSA public key verifying RS256 access tokens (SEC-002)
# DOC_API_JWT_ISSUER=https://identity.example.com  # Authoritative token issuer (SEC-002)
# DOC_API_JWT_AUDIENCE=doc-extractor-api           # Authoritative token audience (SEC-002)
# DOC_API_IDENTITY_PROVIDER_ENABLED=true          # Product-owned identity & token lifecycle
# DOC_API_OIDC_SSO_ENABLED=true                   # Customer OIDC federation & SSO
