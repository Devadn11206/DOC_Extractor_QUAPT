# Environment Configuration for Document Extraction Engine - Module A
# NOTE: All configuration values must support private, on-premise / VPC customer deployment.
# Secrets and encryption keys MUST come from environment or KMS/HSM, never committed.

# Application Environment: development | staging | production
APP_ENV=development
APP_NAME=doc-extraction-engine
SERVICE_NAME=module-a-ingestion
LOG_LEVEL=INFO
DEBUG=false

# Deployment & Network Isolation (ARC-001, SEC-011)
# Fail-closed: Deny outbound external egress
ALLOW_EXTERNAL_EGRESS=false

# Ingestion Constraints & Guardrails (FR-ING-001, FR-ING-002, GR-001)
MAX_FILE_SIZE_BYTES=52428800           # 50 MB default max upload size
MAX_PAGE_COUNT=100                     # Max pages allowed per document
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/tiff
TARGET_RENDER_DPI=200                  # Strict PRD standard: 200 DPI (FR-ING-004, SCH-013)

# Storage & Multi-Tenancy (ARC-003, SEC-005, SEC-006)
STORAGE_BASE_DIR=./data/storage
ENABLE_STORAGE_ENCRYPTION=false        # In production, must be true backed by customer KMS/HSM

# Security & Malware Scanning (FR-ING-003, SEC-009)
MALWARE_SCAN_ENABLED=true
MALWARE_SCANNER_TYPE=mock              # Options in later phases: mock, clamav_socket, offline_bundle

